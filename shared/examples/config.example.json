{
  "schema_version": 1,
  "bindings": {
    "mouse.side_front.press": "toggle_recording",
    "mouse.side_rear.press": "trigger_secondary_action",
    "hotkey.record_toggle": "toggle_recording"
  },
  "transcriber": {
    "backend": "faster_whisper",
    "model_name": "medium",
    "device": "cuda",
    "language": "auto"
  },
  "vocabulary": {
    "terms": ["prophage", "phage"],
    "corrections": {
      "湿菌体": "噬菌体"
    }
  },
  "input": {
    "front_button": "x1",
    "rear_button": "x2",
    "record_hotkey_keycodes": [42, 125, 193],
    "gesture_trigger_button": "rear"
  },
  "output": {
    "enter_mode": "enter",
    "auto_paste": true
  },
  "startup": {
    "prewarm_on_start": true
  },
  "logs": {
    "level": "info"
  }
}
